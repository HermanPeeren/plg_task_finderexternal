<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="params">
		<fieldset name="task_params">
			<field
				name="site_label"
				type="text"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_SITE_LABEL_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_SITE_LABEL_DESC"
				required="true"
				filter="string"
				hint="Example Documentation"
			/>

			<field
				name="note_sources"
				type="note"
				label="PLG_TASK_FINDEREXTERNAL_NOTE_SOURCES_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_NOTE_SOURCES_DESC"
			/>
			<field
				name="sitemaps"
				type="textarea"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_SITEMAPS_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_SITEMAPS_DESC"
				rows="2"
				filter="string"
				hint="https://www.example.org/sitemap.xml"
			/>
			<field
				name="feeds"
				type="textarea"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_FEEDS_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_FEEDS_DESC"
				rows="2"
				filter="string"
			/>
			<field
				name="start_urls"
				type="textarea"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_START_URLS_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_START_URLS_DESC"
				rows="2"
				filter="string"
			/>
			<field
				name="max_depth"
				type="number"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_MAX_DEPTH_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_MAX_DEPTH_DESC"
				default="0"
				min="0"
				max="50"
				step="1"
				filter="int"
			/>

			<field
				name="note_urls"
				type="note"
				label="PLG_TASK_FINDEREXTERNAL_NOTE_URLS_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_NOTE_URLS_DESC"
			/>
			<field
				name="scope"
				type="textarea"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_SCOPE_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_SCOPE_DESC"
				rows="3"
				filter="raw"
			/>
			<field
				name="exclude"
				type="textarea"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_EXCLUDE_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_EXCLUDE_DESC"
				rows="4"
				filter="raw"
			/>
			<field
				name="index_only"
				type="textarea"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_INDEX_ONLY_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_INDEX_ONLY_DESC"
				rows="2"
				filter="raw"
			/>

			<field
				name="note_content"
				type="note"
				label="PLG_TASK_FINDEREXTERNAL_NOTE_CONTENT_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_NOTE_CONTENT_DESC"
			/>
			<field
				name="content_selector"
				type="text"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_CONTENT_SELECTOR_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_CONTENT_SELECTOR_DESC"
				default="main, article"
				filter="raw"
			/>
			<field
				name="title_selector"
				type="text"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_TITLE_SELECTOR_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_TITLE_SELECTOR_DESC"
				default="h1"
				filter="raw"
			/>
			<field
				name="remove_selectors"
				type="textarea"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_REMOVE_SELECTORS_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_REMOVE_SELECTORS_DESC"
				rows="3"
				filter="raw"
			/>
			<field
				name="description_source"
				type="list"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_DESCRIPTION_SOURCE_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_DESCRIPTION_SOURCE_DESC"
				default="meta"
				filter="word"
				>
				<option value="meta">PLG_TASK_FINDEREXTERNAL_FIELD_DESCRIPTION_SOURCE_META</option>
				<option value="content">PLG_TASK_FINDEREXTERNAL_FIELD_DESCRIPTION_SOURCE_CONTENT</option>
			</field>
			<field
				name="date_selector"
				type="text"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_DATE_SELECTOR_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_DATE_SELECTOR_DESC"
				filter="raw"
			/>
			<field
				name="author_selector"
				type="text"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_AUTHOR_SELECTOR_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_AUTHOR_SELECTOR_DESC"
				filter="raw"
			/>
			<field
				name="category_selector"
				type="text"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_CATEGORY_SELECTOR_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_CATEGORY_SELECTOR_DESC"
				filter="raw"
			/>

			<field
				name="note_index"
				type="note"
				label="PLG_TASK_FINDEREXTERNAL_NOTE_INDEX_LABEL"
			/>
			<field
				name="language"
				type="contentlanguage"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_LANGUAGE_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_LANGUAGE_DESC"
				default="*"
				>
				<option value="*">JALL</option>
			</field>
			<field
				name="access"
				type="accesslevel"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_ACCESS_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_ACCESS_DESC"
				default="1"
				filter="int"
			/>

			<field
				name="note_crawl"
				type="note"
				label="PLG_TASK_FINDEREXTERNAL_NOTE_CRAWL_LABEL"
			/>
			<field
				name="recheck_days"
				type="number"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_RECHECK_DAYS_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_RECHECK_DAYS_DESC"
				default="7"
				min="0"
				max="365"
				step="1"
				filter="int"
			/>
			<field
				name="request_delay"
				type="number"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_REQUEST_DELAY_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_REQUEST_DELAY_DESC"
				default="500"
				min="0"
				max="10000"
				step="100"
				filter="int"
			/>
			<field
				name="respect_robots"
				type="radio"
				layout="joomla.form.field.radio.switcher"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_RESPECT_ROBOTS_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_RESPECT_ROBOTS_DESC"
				default="1"
				filter="integer"
				>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
			<field
				name="user_agent"
				type="text"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_USER_AGENT_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_USER_AGENT_DESC"
				filter="string"
			/>
			<field
				name="time_budget"
				type="number"
				label="PLG_TASK_FINDEREXTERNAL_FIELD_TIME_BUDGET_LABEL"
				description="PLG_TASK_FINDEREXTERNAL_FIELD_TIME_BUDGET_DESC"
				default="20"
				min="5"
				max="300"
				step="1"
				filter="int"
			/>
		</fieldset>
	</fields>
</form>
